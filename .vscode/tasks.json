{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Abyss - Setup",
      "type": "shell",
      "command": "echo",
      "args": ["Setup is not supported on this platform."],
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/initial-setup-macos.sh", "${workspaceFolder}", "setup"]
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/initial-setup-linux.sh", "${workspaceFolder}", "setup"]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/initial-setup-win.ps1",
          "-TargetDir",
          "${workspaceFolder}",
          "-Action",
          "setup"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Abyss - Build my project",
      "type": "shell",
      "command": "pnpm",
      "args": ["build"],
      // Linux: build-linux.sh shows the package-format picker (AppImage / deb /
      // rpm / pacman) and resolves pnpm from PATH or known install paths itself.
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/build-linux.sh"]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Abyss - Deploy",
      "type": "shell",
      "command": "echo",
      "args": ["Deploy is only supported on Linux and Windows."],
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/deploy-appimage.sh"]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/deploy-portable.ps1"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Abyss - Build & Deploy",
      "dependsOrder": "sequence",
      "dependsOn": ["Abyss - Build my project", "Abyss - Deploy"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}